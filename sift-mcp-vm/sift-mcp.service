[Unit]
Description=Sift MCP server (DFIR tools over MCP/HTTP)
After=network.target

[Service]
Type=simple
# Edit User and the two paths in ExecStart to match your VM. The venv and
# server.py both live at the repo root (where you cloned this repo).
User=sansforensics
Environment=SIFT_EVIDENCE_ROOT=/cases
Environment=SIFT_OUTPUT_ROOT=/cases/output
Environment=SIFT_HOST=0.0.0.0
Environment=SIFT_PORT=8000
Environment=SIFT_TRANSPORT=streamable-http
ExecStart=/home/sansforensics/sift-mcp-vm/.venv/bin/python /home/sansforensics/sift-mcp-vm/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
